# Copy to .env and adjust. Values below are development defaults.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:Admin123@localhost:5432/SB_db?schema=public"

NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Browser origins allowed by CORS (dev: vite dev server). In Docker same-origin via nginx.
CORS_ORIGIN="http://localhost:5173"
WEB_ORIGIN="http://localhost:5173"

# HMAC secrets for access/refresh JWTs - MUST be replaced in production
JWT_ACCESS_SECRET=dev-access-secret-change-me-in-production-0001
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-in-production-0002
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# base64-encoded 32+ byte key used to encrypt camera credentials and integration secrets
ENCRYPTION_KEY=MTIzNDU2Nzg5MGFiY2RlZjEyMzQ1Njc4OTBhYmNkZWY=

# General / auth rate limits (requests per minute per IP)
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# Where visitor photo uploads are stored (relative or absolute path)
UPLOAD_DIR=uploads

# Seed demo data on startup (Docker entrypoint). Keep false for production.
SEED_DEMO=false
